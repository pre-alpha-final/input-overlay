<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="InputOverlayXbox.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.GameInput" Version="4.0.302" GeneratePathProperty="true" IncludeAssets="none" />
    <Content Include="$(PkgMicrosoft_GameInput)/native/bin/x64/GameInputRedist.dll;$(PkgMicrosoft_GameInput)/native/bin/x64/GameInputRawInputProxy.exe"
             Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_GameInput)/LICENSE.txt" Link="GameInput.LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_GameInput)/NOTICE.txt" Link="GameInput.NOTICE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
